rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY SETUP ONLY.
    // Use this only for the first few minutes to sign up and initialize the first admin/workspace,
    // then immediately replace it with firestore.rules.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
